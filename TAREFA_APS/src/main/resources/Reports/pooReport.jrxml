	<query language="sql"><![CDATA[SELECT 
    t.id AS turma_id,
    t.horario,
    t.limite_alunos,
    t.data_inicio,
    t.data_fim,
    t.fechada,
    c.id AS curso_id,
    c.nome AS curso_nome,
    c.carga_horaria,
    p_prof.nome AS professor_nome,
    prof.titulacao,
    COUNT(ta.aluno_cpf) AS qtd_alunos
FROM turma t
INNER JOIN curso c 
    ON c.id = t.id_curso
INNER JOIN professor prof 
    ON prof.cpf = t.cpf_professor
INNER JOIN pessoa p_prof 
    ON prof.cpf = p_prof.cpf
LEFT JOIN turma_alunos ta 
    ON t.id = ta.turma_id
GROUP BY 
    t.id, 
    t.horario, 
    t.limite_alunos, 
    t.data_inicio, 
    t.data_fim, 
    t.fechada,
    c.id, 
    c.nome, 
    c.carga_horaria, 
    p_prof.nome, 
    prof.titulacao;]]></query>

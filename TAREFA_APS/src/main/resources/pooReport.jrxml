	<subDataset name="TOTAL_ALUNOS" uuid="be1dca0c-43e0-4329-8aac-b5aa9aa79a6e">
		<queryString language="SQL">
			<![CDATA[select *
from pessoa p
where p.cpf = (
	select a.cpf
	from aluno a
	where a.cpf = p.cpf
	order by p.nome
)
]]>
		</queryString>
		<field name="cpf" class="java.lang.Long"/>
		<field name="nome" class="java.lang.String"/>
		<field name="data_nascimento" class="java.sql.Date"/>
